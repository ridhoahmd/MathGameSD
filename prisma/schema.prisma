generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  firebaseUid   String?  @unique
  username      String   @unique
  role          String   @default("siswa")
  coins         Int      @default(0)
  totalScore    Int      @default(0)
  photoURL      String?
  inventory     Json     @default("[\"default\"]")
  activeTheme   String   @default("default")
  equippedFrame String   @default("default")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  scores        Score[]
}

model Game {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  title       String
  description String?
  scores      Score[]
}

model Score {
  id       Int      @id @default(autoincrement())
  score    Int
  playedAt DateTime @default(now())
  userId   Int
  gameId   Int
  game     Game     @relation(fields: [gameId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GameQuestion {
  id        Int      @id @default(autoincrement())
  category  String
  level     String
  content   Json
  createdAt DateTime @default(now())

  @@index([category, level])
}
