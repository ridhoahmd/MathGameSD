generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Data User (Pemain)
model User {
  id            Int      @id @default(autoincrement())
  firebaseUid   String?  @unique
  username      String   @unique
  role          String   @default("siswa")
  coins         Int      @default(0)
  totalScore    Int      @default(0)
  xp            Int      @default(0) // Poin pengalaman
  level         Int      @default(0) // Level pemain
  photoURL      String?
  inventory     Json     @default("[\"default\"]") // Barang yang dimiliki
  activeTheme   String   @default("default")
  equippedFrame String   @default("default")
  equippedBadge     String?
  equippedMascot    String?  // ID maskot yang sedang dipakai (null = tidak ada)
  equippedAccessory String?  // ID aksesori avatar yang sedang dipakai (null = tidak ada)
  createdAt         DateTime @default(now())
  updatedAt     DateTime @updatedAt
  scores        Score[]
  versusMatches VersusMatch[]
}


// Data Game
model Game {
  id          Int     @id @default(autoincrement())
  slug        String  @unique // ID unik game (misal: math, zuma)
  title       String
  description String?
  scores      Score[]
  versusMatches VersusMatch[]
}

// Riwayat Skor
model Score {
  id       Int      @id @default(autoincrement())
  score    Int
  playedAt DateTime @default(now())
  userId   Int
  gameId   Int
  game     Game     @relation(fields: [gameId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Bank Soal
model GameQuestion {
  id        Int      @id @default(autoincrement())
  category  String
  level     String
  content   Json
  kodeKelas String?  // BUG-M02 FIX: field khusus untuk soal kelas tertentu (null = soal publik)
  createdAt DateTime @default(now())

  @@index([category, level])
  @@index([category, level, kodeKelas]) // Index untuk query soal kelas spesifik
}

// Riwayat Duel (Mode Versus)
model VersusMatch {
  id        Int      @id @default(autoincrement())
  p1Score   Int
  p2Name    String
  status    String   // "Win", "Lose", "Draw"
  playedAt  DateTime @default(now())
  p1Id      Int
  gameId    Int
  
  user      User     @relation(fields: [p1Id], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id])
}
