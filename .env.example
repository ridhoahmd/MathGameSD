# =============================================================
# MATHGAMESD — ENVIRONMENT VARIABLES TEMPLATE
# Salin file ini: cp .env.example .env
# Isi semua nilai di bawah, JANGAN commit file .env ke git!
# =============================================================

# --- SERVER ---
PORT=3000
NODE_ENV=development

# Domain yang diizinkan untuk Socket.IO CORS (pisah koma jika lebih dari 1)
# Development: http://localhost:3000
# Production : https://domain-kamu.com,https://www.domain-kamu.com
ALLOWED_ORIGINS=http://localhost:3000

# --- DATABASE (PostgreSQL) ---
# Contoh Railway: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://user:password@host:port/dbname"

# --- JWT (Generate dengan: node -e "require('crypto').randomBytes(64).toString('hex')|0") ---
# Cara generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="ganti_dengan_hex_acak_64_byte_panjang"

# --- PASSWORD GURU/ADMIN ---
# Gunakan password yang kuat, minimal 12 karakter, gabungkan huruf+angka+simbol
GURU_PASSWORD="ganti_dengan_password_kuat_anda"

# --- FIREBASE (Auth Client) ---
# Ambil dari Firebase Console → Project Settings → Your Apps
FIREBASE_API_KEY="AIzaSy_GANTI_DENGAN_KEY_FIREBASE_ANDA"
API_KEY="AIzaSy_GANTI_DENGAN_KEY_FIREBASE_ANDA"

# --- AI SERVICE (ZhipuAI / GLM-4-Flash) ---
# Daftar di: https://open.bigmodel.cn
# Format: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.yyyyyyyyyyyyyyyyyy
ZHIPU_API_KEY="ganti_dengan_api_key_zhipu_anda"
